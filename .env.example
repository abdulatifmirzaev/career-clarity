# -----------------------------------------------------------------------------
# Career Clarity - Environment Configuration
# -----------------------------------------------------------------------------

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/career_clarity_dev?schema=public"

# Backend API
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# JWT Authentication
JWT_ACCESS_SECRET="super_secure_access_secret_change_in_production_min_32_chars"
JWT_REFRESH_SECRET="super_secure_refresh_secret_change_in_production_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Next.js Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
